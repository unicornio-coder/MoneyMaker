# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Belvo (developers.belvo.com → Dashboard → API Keys). Sandbox mientras no haya producción.
BELVO_SECRET_ID=
BELVO_SECRET_PASSWORD=
BELVO_ENV=sandbox
BELVO_WEBHOOK_SECRET=

# Anthropic (categorización de movimientos desconocidos y lectura de estados de cuenta)
ANTHROPIC_API_KEY=

# Google OAuth (login con Google y, en modo prueba, lectura de alertas de Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Fuentes de datos en modo mock cuando no hay llaves: true | false
NEXT_PUBLIC_USE_MOCK=true

# Cifrado de credenciales de conectores (Gmail, Bitso): cualquier cadena secreta de 32+ caracteres
CREDENTIALS_KEY=
# Cron de Vercel (Settings → Environment Variables; Vercel lo manda como Bearer)
CRON_SECRET=

# Stripe (Developers → API keys; productos con precios mensual y anual; webhook → /api/stripe/webhook)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MENSUAL=
STRIPE_PRICE_ANUAL=
